# PocketBase Configuration
# Copy this file to .env and customize as needed

# PocketBase server URL (default: local development server)
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Companion server URL (for question generation)
VITE_COMPANION_SERVER_URL=http://127.0.0.1:3001

# Companion server port (used by fastreader-server)
COMPANION_PORT=3001

# MCP config file path (optional, defaults to .mcp.json in project root)
# MCP_CONFIG_PATH=/path/to/your/.mcp.json
